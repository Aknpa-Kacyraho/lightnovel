FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin lntrans

WORKDIR /app
COPY . /app

USER 10001:10001
EXPOSE 8099

CMD ["python", "lntrans/lnserve.py", "--port", "8099"]

