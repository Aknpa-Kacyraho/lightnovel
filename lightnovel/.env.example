# OpenAI-compatible endpoint. Local loopback endpoints do not require a key.
LNTRANS_LLM_BASE_URL=https://api.deepseek.com/chat/completions
LNTRANS_LLM_API_KEY=

# Optional per-role endpoints/keys (override the global endpoint above).
# LNTRANS_LLM_BASE_URL_TRANSLATE=http://127.0.0.1:50087/v1/chat/completions
# LNTRANS_LLM_API_KEY_TRANSLATE=
# LNTRANS_LLM_BASE_URL_AUXILIARY=http://127.0.0.1:50087/v1/chat/completions
# LNTRANS_LLM_API_KEY_AUXILIARY=
# LNTRANS_LLM_BASE_URL_REVIEW=https://api.deepseek.com/chat/completions
# LNTRANS_LLM_API_KEY_REVIEW=

# One model per task role. Leave them equal if the provider exposes one model.
LNTRANS_MODEL_TRANSLATE=deepseek-flash
LNTRANS_MODEL_AUXILIARY=deepseek-flash
LNTRANS_MODEL_REVIEW=deepseek-flash

# Automatic fallback for translate/auxiliary when their primary endpoint is
# unreachable (connection error / timeout / auth / 404 / 5xx). Not used by review.
# LNTRANS_LLM_FALLBACK=1
# LNTRANS_LLM_FALLBACK_BASE_URL=https://api.deepseek.com/chat/completions
# LNTRANS_LLM_FALLBACK_MODEL=deepseek-flash
# LNTRANS_LLM_FALLBACK_API_KEY=

# Prices are CNY per million tokens. Set values matching your provider.
LNTRANS_PRICE_INPUT_CNY_PER_M=2
LNTRANS_PRICE_OUTPUT_CNY_PER_M=8
# Optional role-specific overrides:
# LNTRANS_TRANSLATE_PRICE_INPUT_CNY_PER_M=2
# LNTRANS_TRANSLATE_PRICE_OUTPUT_CNY_PER_M=8
# LNTRANS_AUXILIARY_PRICE_INPUT_CNY_PER_M=1
# LNTRANS_AUXILIARY_PRICE_OUTPUT_CNY_PER_M=4
# LNTRANS_REVIEW_PRICE_INPUT_CNY_PER_M=2
# LNTRANS_REVIEW_PRICE_OUTPUT_CNY_PER_M=8
# DeepSeek fallback/review prices are separate from the (possibly 0) local prices:
# LNTRANS_DEEPSEEK_PRICE_INPUT_CNY_PER_M=2
# LNTRANS_DEEPSEEK_PRICE_OUTPUT_CNY_PER_M=8

# 0 means no limit.
LNTRANS_DAILY_BUDGET_CNY=0
LNTRANS_JOB_BUDGET_CNY=0

LNTRANS_LLM_TIMEOUT=180
LNTRANS_LLM_RETRIES=3
LNTRANS_LLM_MAX_OUTPUT_TOKENS=8000

# Chapter-block translation. `batch` uses numbered chunks (#N); `sakura` uses the
# model's own JP->ZH prompt for sentence-level engines. Both send a whole chapter,
# splitting only when it exceeds the per-provider character limit.
LNTRANS_TRANSLATE_MODE=batch
LNTRANS_CHAPTER_CHARS=2160
LNTRANS_DEEPSEEK_CHAPTER_CHARS=6000
# Reasoning tokens count against max_tokens; too small truncates the answer.
LNTRANS_DEEPSEEK_MAX_TOKENS=32000
LNTRANS_CHAPTER_TOK=30000
# Segments per request in batch mode; lower it for small local models.
# LNTRANS_SEG_LINES=60
# A worker that stops heartbeating for this long is considered dead; local
# whole-chapter generation can take minutes, so both values are generous.
LNTRANS_JOB_STALE_SEC=900
LNTRANS_JOB_STALL_LOG_SEC=600

# LAN access. Use either a value or a separate secret file; the file is never
# included in the share package. Empty means a random token is printed at launch.
# LNTRANS_TOKEN=
# LNTRANS_TOKEN_FILE=/run/secrets/lightnovel-token
# Comma-separated extra hostnames accepted in Host (for Tailscale/proxy setups).
# LNTRANS_ALLOWED_HOSTS=reader.local,lightnovel.example.ts.net
# How long a browser that logged in once stays remembered (restarts included).
# Only the SHA-256 of a random device secret is stored, never the master token.
LNTRANS_DEVICE_DAYS=180

# Brute-force / accidental repeated-start limits.
LNTRANS_LOGIN_LIMIT=5
LNTRANS_LOGIN_WINDOW=600
LNTRANS_TRANSLATE_LIMIT=12
LNTRANS_TRANSLATE_WINDOW=300
